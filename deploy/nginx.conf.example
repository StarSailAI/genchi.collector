# Replace __DOMAIN__ and __WEB_PORT__, then install under sites-available/genchi.
# Certbot --nginx adds the certificate and HTTP-to-HTTPS redirect.
# This log format intentionally excludes query strings containing login tokens.
log_format genchi_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                      '$status $body_bytes_sent';

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    server_tokens off;
    access_log /var/log/nginx/genchi-access.log genchi_safe;
    error_log /var/log/nginx/genchi-error.log warn;
    client_max_body_size 64k;

    location = /api/webhooks/resend {
        proxy_pass http://127.0.0.1:__PRODUCT_PORT__/webhooks/resend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }

    location = /mcp {
        proxy_pass http://127.0.0.1:__PRODUCT_PORT__/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location ^~ /agent/ {
        proxy_pass http://127.0.0.1:__PRODUCT_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:__WEB_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
