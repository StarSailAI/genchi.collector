# 唯一需要编辑的文件：两个仓库上一级的 .env。
# python3 genchi.collector/deploy/manage.py init --site-url http://YOUR_SERVER_IP
# 会复制本模板，并自动生成下方所有内部密码。不要把此文件提交到 Git。
# 值包含空格、# 或 $ 时请使用单引号，例如 RESEND_API_KEY='your value'。

# ===== 你需要填写：网站与管理员 =====
# 初次可用服务器 IP 的 http 地址。正式域名解析到服务器后改为 https://你的域名。
# 使用标准 80/443 端口，不要添加 /zh-Hans 或结尾斜杠。
PUBLIC_SITE_URL=http://localhost
ADMIN_EMAIL=

# ===== 你需要填写：兼容 Chat Completions 的模型 API（三项一起填写） =====
# 可填 API 根地址、以 /v1 结尾的地址或完整 /chat/completions 地址。
# 未填写时采集原文照常进行，模型处理队列暂停，已迁移活动可正常浏览。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_RESPONSE_FORMAT=auto

# ===== 正式邮件统一使用 Resend；只需填写 API key 并核对发件地址 =====
# 通过 Resend 官方 SMTP 接口发送，TLS / 主机 / 用户名由部署工具自动配置。
# API key 为空时暂停发送，邮件队列保留；不会改投到其他邮件服务。
# MAIL_FROM 必须属于你在 Resend 已验证的域名。
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM='Genchi <hello@example.com>'
# 收信转发共用上述 API key，需要 Full access；转发目标为 ADMIN_EMAIL。
# inbound-setup.py 自动创建 webhook 并填入签名密钥，无需另建 API key。
RESEND_WEBHOOK_SECRET=

# ===== 可选：官方 X 采集 =====
# 默认由 Camoufox 匿名读取公开时间线及推文详情，验收后设置 ENABLE_X=true。
# cookies 模式才需要 X_COOKIES_FILE（服务器上的 Playwright Cookie 数组 JSON）。
ENABLE_X=false
X_AUTH_MODE=anonymous
X_COOKIES_FILE=

# ===== 自动生成：首次初始化后不要随意修改 =====
POSTGRES_PASSWORD=
GENCHI_READER_PASSWORD=
CONTROL_API_TOKEN=
ENROLLMENT_TOKEN=
BROWSER_API_TOKEN=
PRODUCT_SECRET=
PRODUCT_PROXY_SECRET=
PRODUCT_ADMIN_TOKEN=

# ===== 2 核 4GB 起步设置，通常不需要修改 =====
GENCHI_IMAGE_TAG=current
ALLFEEDS_NODE_ID=genchi-production-01
ALLFEEDS_WORKER_CONCURRENCY=2
BROWSER_CONCURRENCY=1
BROWSER_SHM_SIZE=512m
DB_POOL_MIN=1
DB_POOL_MAX=8
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5433
CONTROL_BIND_HOST=127.0.0.1
CONTROL_PORT=8060
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_PORT=8050
PRODUCT_PORT=18080
MAILPIT_PORT=18025
WEB_BIND_HOST=127.0.0.1
WEB_PORT=13000
GENCHI_SCHEMA_MAJOR=1
LOG_LEVEL=INFO
BACKUP_KEEP_DAYS=7

# Enable only with the trusted Nginx header configuration and private web port.
AUTH_TRUST_PROXY=false
AUTH_REGISTRATION_OPEN=true
