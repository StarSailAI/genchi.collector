# 唯一需要编辑的文件：两个仓库上一级的 .env。
# python3 genchi.collector/deploy/manage.py init --site-url http://YOUR_SERVER_IP
# 会复制本模板，并自动生成下方所有内部密码。不要把此文件提交到 Git。
# 值包含空格、# 或 $ 时请使用单引号，例如 SMTP_PASSWORD='your value'。

# ===== 你需要填写：网站与管理员 =====
# 初次可用服务器 IP 的 http 地址。正式域名解析到服务器后改为 https://你的域名。
# 使用标准 80/443 端口，不要添加 /zh-Hans 或结尾斜杠。
PUBLIC_SITE_URL=http://localhost
ADMIN_EMAIL=

# ===== 你需要填写：兼容 Chat Completions 的模型 API（三项一起填写） =====
# 可填 API 根地址、以 /v1 结尾的地址或完整 /chat/completions 地址。
# 未填写时采集原文照常进行，模型处理队列暂停，已迁移活动可正常浏览。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_RESPONSE_FORMAT=auto

# ===== 正式邮件：未配置前使用服务器私网内的 Mailpit 收件 =====
# 替换为邮箱服务商提供的配置；常用 587 + starttls 或 465 + ssl。
# ADMIN_EMAIL 是登录管理员邮箱；MAIL_FROM 是服务商允许的发件地址。
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM='Genchi <hello@genchi.local>'

# ===== 可选：官方 X 采集 =====
# 网站 / 票务来源不需要此项。X 需要有效的登录 Cookie JSON（Playwright cookies 数组）。
# 将文件放在服务器上，填写绝对路径后再把 ENABLE_X 改成 true。
ENABLE_X=false
X_COOKIES_FILE=
CLOAKBROWSER_LICENSE_KEY=

# ===== 自动生成：首次初始化后不要随意修改 =====
POSTGRES_PASSWORD=
GENCHI_READER_PASSWORD=
CONTROL_API_TOKEN=
ENROLLMENT_TOKEN=
CLOAKBROWSER_API_TOKEN=
PRODUCT_SECRET=
PRODUCT_ADMIN_TOKEN=

# ===== 2 核 4GB 起步设置，通常不需要修改 =====
GENCHI_IMAGE_TAG=current
ALLFEEDS_NODE_ID=genchi-production-01
ALLFEEDS_WORKER_CONCURRENCY=2
CLOAKBROWSER_CONCURRENCY=1
CLOAKBROWSER_SHM_SIZE=512m
CLOAKBROWSER_IMAGE=cloakhq/cloakbrowser:0.4.12
DB_POOL_MIN=1
DB_POOL_MAX=8
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5433
CONTROL_BIND_HOST=127.0.0.1
CONTROL_PORT=8060
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_PORT=8050
PRODUCT_PORT=18080
MAILPIT_PORT=18025
WEB_BIND_HOST=127.0.0.1
WEB_PORT=13000
GENCHI_SCHEMA_MAJOR=1
LOG_LEVEL=INFO
BACKUP_KEEP_DAYS=7
