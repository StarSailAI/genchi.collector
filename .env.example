# Run python3 scripts/init-local-env.py to generate independent local credentials.
# Production: use deploy/manage.py init instead (see docs/production.md).
POSTGRES_PASSWORD=
GENCHI_READER_PASSWORD=
CONTROL_API_TOKEN=
ENROLLMENT_TOKEN=
BROWSER_API_TOKEN=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_RESPONSE_FORMAT=auto
# Homepage Q&A, independent model; Compose reuses LLM_* endpoint/key when empty.
ASK_LLM_BASE_URL=
ASK_LLM_API_KEY=
ASK_LLM_MODEL=deepseek-flash

# Resident CAPTCHA operator. Empty endpoint/key reuse LLM_BASE_URL / LLM_API_KEY.
# Set a vision-capable model explicitly; do not reuse the text-only model name.
VERIFICATION_AGENT_ENABLED=false
VERIFICATION_LLM_BASE_URL=
VERIFICATION_LLM_API_KEY=
VERIFICATION_LLM_MODEL=
VERIFICATION_DAILY_MODEL_CALLS=40

POSTGRES_PORT=5433
CONTROL_PORT=8060
DASHBOARD_PORT=8050
ALLFEEDS_WORKER_CONCURRENCY=4
LOG_LEVEL=INFO

# Product v2: generate independent random values (at least 32 characters)
PRODUCT_SECRET=
PRODUCT_ADMIN_TOKEN=
PUBLIC_SITE_URL=http://localhost:13000
ADMIN_EMAIL=admin@genchi.local
PRODUCT_PORT=18080
MAILPIT_PORT=18025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Genchi <hello@genchi.local>
RESEND_API_KEY=
COLLECTION_DIGEST_ENABLED=false
COLLECTION_DIGEST_TIMEZONE=Asia/Tokyo
COLLECTION_DIGEST_NOT_BEFORE=18:00
COLLECTION_DIGEST_FORCE_AT=23:00

# Email-code login: server-only secret shared with genchi.news (32+ characters).
PRODUCT_PROXY_SECRET=
AUTH_REGISTRATION_OPEN=true
